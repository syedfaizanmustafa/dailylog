rules_version = '2';

// Receipt PDFs and signature images are private: staff read/write; customers
// get receipts through the public /r/{token} Cloud Function, never directly.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 5 * 1024 * 1024;
    }
    // Customer signature images uploaded with log sheets (New Entry).
    match /signatures/{file} {
      allow read: if request.auth != null;
      // (The app uploads with putData and no content type, so only size is checked.)
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
