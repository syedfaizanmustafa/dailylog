{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/r/**",
        "function": {
          "functionId": "receipt",
          "region": "us-central1"
        }
      },
      {
        "source": "/twilio/status",
        "function": {
          "functionId": "twilioStatus",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "receipts",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
